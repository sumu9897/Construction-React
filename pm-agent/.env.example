# Copy to .env and fill in. Never commit the real file.

# From @BotFather on Telegram: /newbot, then copy the token.
TELEGRAM_BOT_TOKEN=

# Comma-separated chat ids allowed to talk to the bot.
# Leave empty on first run, message the bot once, and read the id out of the log.
# An open PM bot leaks contract sums and rates - the allowlist is not optional.
TELEGRAM_ALLOWED_CHAT_IDS=

# Where the Project Ledger lives. Point this at a PRIVATE git repo, outside this
# one. Defaults to ../projects relative to pm-agent if unset.
LEDGER_ROOT=/Users/you/ledger/projects

# --- Question answering (/ask) --------------------------------------------
# This uses YOUR Claude Code CLI, not an API key. There is no API integration in
# this repo at all - the bot shells out to `claude`.
#
# If you already run Claude Code on this machine, it is already set up: the login
# lives in ~/.claude and `claude -p` inherits it. Nothing to configure here.
#
# The one catch is launchd, which does not reliably set HOME. Without HOME the
# service cannot find that login. See the plist in the README, and run
# `pm doctor --deep` as the service user to confirm.

PM_CLAUDE_MODEL=sonnet

# Cap per question, passed to the CLI. Do not set this below about 0.35: Claude
# Code sends a large system prompt, so the same question costs ~$0.01 with a warm
# prompt cache and ~$0.25 cold. A tighter cap works all morning and then starts
# failing after an idle period, which is miserable to debug.
PM_CLAUDE_BUDGET_USD=0.5

# Cap per day across all questions. A runaway loop should cost a few dollars, not
# a few hundred. Roughly 20 questions at typical ledger size.
PM_CLAUDE_DAILY_USD=5

# Override the binary if it is not on PATH (common under launchd).
# PM_CLAUDE_BIN=/opt/homebrew/bin/claude

# --- Voice notes (optional, off by default) -------------------------------
# Leave this unset and the bot simply asks for text - which is a perfectly good
# way to run it. Nothing else is affected.
#
# If you ever want it, transcription runs as a command, so any engine works.
# {input} and {output} are substituted.
# PM_TRANSCRIBE_CMD=whisper-cli -m ~/.whisper/ggml-base.en.bin -f {input} --output-txt --output-file {output} -nt
# PM_TRANSCRIBE_ACCEPTS_OGG=1
# PM_FFMPEG=ffmpeg
